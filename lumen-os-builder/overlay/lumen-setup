#!/usr/bin/env python3
import gi, os, subprocess, shutil
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk
CSS = b"""
window{background-color:#f3f3f3;background-image:none}
.card{background-color:#fff;background-image:none;border-radius:12px;border:1px solid #e0e0e0}
.h{font-size:28px;font-weight:600;color:#1b1b1b}.s{font-size:14px;color:#605e5c}
button.pri{background-color:#0067c0;background-image:none;color:#fff;border-radius:6px;border:none;padding:8px 30px}
button.sec{background-color:#fff;background-image:none;border:1px solid #d1d1d1;border-radius:6px;padding:8px 24px}
"""
NAME = "Lumen OS"
try:
    for l in open("/etc/os-release"):
        if l.startswith("PRETTY_NAME="): NAME = l.split("=", 1)[1].strip().strip('"')
except Exception: pass
prov = Gtk.CssProvider(); prov.load_from_data(CSS)
Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
win = Gtk.Window(); win.fullscreen(); win.connect("destroy", Gtk.main_quit)
stack = Gtk.Stack(); stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
dark = {"v": False}
def page(title, sub, extra=None):
    b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
    t = Gtk.Label(label=title); t.get_style_context().add_class("h"); t.set_xalign(0)
    s = Gtk.Label(label=sub); s.get_style_context().add_class("s"); s.set_xalign(0); s.set_line_wrap(True)
    b.pack_start(t, False, False, 0); b.pack_start(s, False, False, 0)
    if extra: b.pack_start(extra, False, False, 12)
    return b
net = Gtk.Button(label="Open network settings"); net.get_style_context().add_class("sec")
net.connect("clicked", lambda *_: subprocess.Popen(["nm-connection-editor"]))
def run(cmd): subprocess.Popen(cmd)
def web(url): run([shutil.which("microsoft-edge-stable") or "xdg-open", url])
def mkbtn(label, fn):
    b = Gtk.Button(label=label); b.get_style_context().add_class("sec"); b.connect("clicked", lambda *_: fn()); return b
msbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
msbox.pack_start(mkbtn("Sign in to your Microsoft account (web)", lambda: web("https://account.microsoft.com")), False, False, 0)
msbox.pack_start(mkbtn("Connect OneDrive", lambda: run(["xfce4-terminal", "--hold", "--title", "OneDrive setup", "-e", "onedrive"])), False, False, 0)
msbox.pack_start(mkbtn("Set up Outlook mail", lambda: run(["thunderbird"])), False, False, 0)
msbox.pack_start(mkbtn("Open Word, Excel and Teams on the web", lambda: web("https://www.microsoft365.com")), False, False, 0)
light = Gtk.RadioButton.new_with_label_from_widget(None, "Light mode")
dk = Gtk.RadioButton.new_with_label_from_widget(light, "Dark mode")
dk.connect("toggled", lambda w: dark.update(v=w.get_active()))
choice = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8); choice.pack_start(light, False, False, 0); choice.pack_start(dk, False, False, 0)
pages = [page("Welcome to " + NAME, "Let's get your PC ready. This only takes a minute."),
         page("Let's connect you to a network", "Pick a Wi-Fi or wired connection so updates and the web work.", net),
         page("Use your Microsoft account", "Optional. Sign in to use Outlook, OneDrive, Word, Excel and Teams. You can skip this and do it later.", msbox),
         page("Choose your look", "You can change this any time in Settings.", choice),
         page("You're all set", "Your PC is ready. Enjoy " + NAME + ".")]
for i, p in enumerate(pages): stack.add_named(p, str(i))
idx = {"i": 0}
nxt = Gtk.Button(label="Next"); nxt.get_style_context().add_class("pri")
back = Gtk.Button(label="Back"); back.get_style_context().add_class("sec")
def show():
    stack.set_visible_child_name(str(idx["i"])); back.set_sensitive(idx["i"] > 0)
    nxt.set_label("Finish" if idx["i"] == len(pages) - 1 else "Next")
def go_next(*_):
    if idx["i"] == len(pages) - 1:
        th = "Arc-Dark" if dark["v"] else "Arc"
        subprocess.call(["xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName", "-n", "-t", "string", "-s", th])
        subprocess.call(["xfconf-query", "-c", "xfwm4", "-p", "/general/theme", "-n", "-t", "string", "-s", th])
        os.makedirs(os.path.expanduser("~/.config"), exist_ok=True)
        open(os.path.expanduser("~/.config/.lumen-setup-done"), "w").close(); Gtk.main_quit()
    else: idx["i"] += 1; show()
def go_back(*_): idx["i"] = max(0, idx["i"] - 1); show()
nxt.connect("clicked", go_next); back.connect("clicked", go_back)
bar = Gtk.Box(spacing=10); bar.pack_end(nxt, False, False, 0); bar.pack_end(back, False, False, 0)
card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24); card.get_style_context().add_class("card")
card.set_margin_start(40); card.set_margin_end(40); card.set_margin_top(40); card.set_margin_bottom(40)
card.pack_start(stack, True, True, 24); card.pack_start(bar, False, False, 24)
outer = Gtk.Box(); outer.set_halign(Gtk.Align.CENTER); outer.set_valign(Gtk.Align.CENTER); outer.set_size_request(640, 380); outer.pack_start(card, True, True, 0)
win.add(outer); show(); win.show_all(); Gtk.main()
